{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/schemas/flyto.resource-presentation.v1.schema.json",
  "title": "flyto.resource-presentation.v1",
  "description": "What an HMI shows for one resource, declared by the device pack. Cloud validates and passes it through unchanged; the App renders each panel through one kind registry. Canonical JSON (sorted keys, compact, UTF-8) must not exceed 16384 bytes; that cap is enforced in code, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "panels"],
  "properties": {
    "schema": {"const": "flyto.resource-presentation.v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {"label": {"$ref": "#/$defs/localized"}}
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/panel"}
    },
    "request_examples": {
      "description": "Example requests for this resource, in the person's words. The App shows them as chips that only fill the request field; nothing is sent until the person sends it. Malformed entries are dropped; the App shows at most 4.",
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/localized"}
    },
    "visual": {
      "description": "Optional. What the resource looks like, from what its vendor already publishes: a URDF or GLB (format, source, packages, files) with the vendor's own link / node names for parts, or, with no vendor model (format none), the outer dimensions of a stand-in shape (fallback). Every file the App may read is an https URL listed in files with the sha256 its bytes must hash to; nothing else is fetched. A model is appearance only: it moves only from the joint readings named in joints, and never shows a task's outcome. An App refuses a malformed block whole and shows no 3D view; absent, nothing changes.",
      "$ref": "#/$defs/visual"
    },
    "surfaces": {
      "description": "Optional. The screen roles this resource can be shown on (a cluster strip, an operator console, a teach pendant ...), each with a default layout over this block's own panels, the panels no layout may hide, and what a binding in that role may do. An HMI binding names one declared role; Cloud stores it on the binding and enforces grants server-side, never by hiding UI. Ids are pack-local; neither Cloud nor the App interprets one. Every panel id named here must be a declared panel (checked on read; a block that names an undeclared panel is omitted whole). Absent, a binding has no role and keeps the pre-role behaviour.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "field": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,31}(\\.[a-z_][a-z0-9_]{0,31}){0,2}$"},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel"],
          "properties": {
            "channel": {"type": "string", "minLength": 1, "maxLength": 128},
            "field": {"$ref": "#/$defs/field"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource"],
          "properties": {"resource": {"enum": ["presence.state", "deployment_mode"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability"],
          "properties": {"capability": {"type": "string", "minLength": 1, "maxLength": 128}}
        }
      ]
    },
    "scalar": {"type": ["string", "number", "boolean"]},
    "leaf_condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "field": {"$ref": "#/$defs/field"},
        "equals": {"$ref": "#/$defs/scalar"},
        "not_equals": {"$ref": "#/$defs/scalar"},
        "in": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/scalar"}},
        "gt": {"type": "number"},
        "lt": {"type": "number"}
      },
      "oneOf": [
        {"required": ["equals"]},
        {"required": ["not_equals"]},
        {"required": ["in"]},
        {"required": ["gt"]},
        {"required": ["lt"]}
      ]
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/leaf_condition"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {"all": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/leaf_condition"}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {"any": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/leaf_condition"}}}
        }
      ]
    },
    "tone": {"enum": ["neutral", "live", "running", "verified", "attention", "refused"]},
    "bound": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/source"}]},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/bound"}, "max": {"$ref": "#/$defs/bound"}}
    },
    "state_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"$ref": "#/$defs/scalar"},
        "label": {"$ref": "#/$defs/localized"},
        "icon": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "tone": {"$ref": "#/$defs/tone"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/localized"},
        "source": {"$ref": "#/$defs/source"},
        "unit": {"type": "string", "maxLength": 16},
        "precision": {"type": "integer", "minimum": 0, "maximum": 3},
        "range": {"$ref": "#/$defs/range"}
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "description": "Open string. readout, gauge, state, progress, list, position2d, joints, media and alert have per-kind requirements; any other kind validates on the common fields and the App renders it as a generic readout.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "label": {"$ref": "#/$defs/localized"},
        "source": {"$ref": "#/$defs/source"},
        "unit": {"type": "string", "maxLength": 16},
        "precision": {"type": "integer", "minimum": 0, "maximum": 3},
        "target_source": {"$ref": "#/$defs/source"},
        "range": {"$ref": "#/$defs/range"},
        "plane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"$ref": "#/$defs/range"}, "y": {"$ref": "#/$defs/range"}}
        },
        "priority": {"enum": ["hero", "primary", "secondary"]},
        "when": {"$ref": "#/$defs/condition"},
        "severity_map": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "tone"],
            "properties": {"when": {"$ref": "#/$defs/condition"}, "tone": {"$ref": "#/$defs/tone"}}
          }
        },
        "states": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/state_option"}},
        "items": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/item"}},
        "ambient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["span"],
          "properties": {"span": {"type": "number", "exclusiveMinimum": 0}}
        },
        "x": {"$ref": "#/$defs/source"},
        "y": {"$ref": "#/$defs/source"},
        "heading": {"$ref": "#/$defs/source"},
        "goal_x": {"$ref": "#/$defs/source"},
        "goal_y": {"$ref": "#/$defs/source"},
        "refusal_codes": {
          "description": "Refusal codes (the resource's own refusal.code) this panel's reading explains. While the HMI's current task was refused with one of them, the App shows this panel as the hero. Opaque pack vocabulary; the App never interprets a code.",
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
        },
        "check_kinds": {
          "description": "Verification check kinds (Cloud's checks[].kind) this panel's reading proves, or the capability a running step uses. While the HMI's current task carries one of them, the App shows this panel as the hero, so the number on screen is the number the proof is about. Opaque pack vocabulary; the App never interprets a kind.",
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "readout"}}}, "then": {"required": ["source"]}},
        {"if": {"properties": {"kind": {"enum": ["gauge", "progress"]}}}, "then": {"required": ["source", "range"]}},
        {
          "if": {"properties": {"kind": {"enum": ["state", "media"]}}},
          "then": {"required": ["source", "states"], "properties": {"states": {"minItems": 1}}}
        },
        {"if": {"properties": {"kind": {"const": "list"}}}, "then": {"required": ["items"], "properties": {"items": {"minItems": 1}}}},
        {
          "if": {"properties": {"kind": {"const": "joints"}}},
          "then": {
            "required": ["items"],
            "properties": {"items": {"minItems": 1, "items": {"required": ["range"]}}}
          }
        },
        {"if": {"properties": {"kind": {"const": "position2d"}}}, "then": {"required": ["x", "y", "plane"]}},
        {"if": {"properties": {"kind": {"const": "alert"}}}, "then": {"required": ["when"]}}
      ]
    },
    "level": {"type": "integer", "minimum": 1, "maximum": 5},
    "panel_size": {"enum": ["chip", "tile", "hero"]},
    "surface_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panels"],
      "properties": {
        "hero": {"$ref": "#/$defs/id"},
        "panels": {
          "description": "The panels this role shows, in order, each at a size. Together with hidden, the only panels a person may arrange on this role.",
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "size"],
            "properties": {"id": {"$ref": "#/$defs/id"}, "size": {"$ref": "#/$defs/panel_size"}}
          }
        },
        "hidden": {
          "description": "Panels this role may show but does not by default.",
          "type": "array", "maxItems": 24, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "level_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_level"],
      "properties": {"max_level": {"$ref": "#/$defs/level"}}
    },
    "surface_grants": {
      "description": "What a binding in this role may do. read is always granted; request admits goals whose every planned step is at or below max_level; approve decides held steps at or below max_level; stop cancels this resource's own tasks. An absent grant is not granted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["read"],
      "properties": {
        "read": {"const": true},
        "request": {"$ref": "#/$defs/level_grant"},
        "approve": {"$ref": "#/$defs/level_grant"},
        "stop": {"type": "boolean"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "aspect", "layout", "grants"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/localized"},
        "aspect": {"enum": ["strip_8_3", "landscape_16_9", "portrait"]},
        "default": {"description": "The role a binding gets when it names none; at most one surface sets it, else the first is the default.", "type": "boolean"},
        "layout": {"$ref": "#/$defs/surface_layout"},
        "grants": {"$ref": "#/$defs/surface_grants"},
        "required_panels": {
          "description": "Panels no layout on this role may hide (safety readings, alerts). Each must be one of layout.panels.",
          "type": "array", "maxItems": 24, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "https_url": {"type": "string", "maxLength": 512, "pattern": "^https://[^\\s#]+$"},
    "file_ref": {
      "description": "An https URL, or package://<name>/<path> resolved through visual.packages.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^(https://|package://[A-Za-z0-9_.-]{1,64}/)[^\\s#]+$"
    },
    "vendor_name": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"},
    "length_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
    "box_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/length_m"}},
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {"enum": ["urdf", "glb", "none"]},
        "source": {"$ref": "#/$defs/file_ref"},
        "packages": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "additionalProperties": {"type": "string", "maxLength": 512, "pattern": "^https://[^\\s#]+/$"}
        },
        "files": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/file_ref"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"up": {"enum": ["z", "y"]}, "units": {"enum": ["m", "cm", "mm"]}}
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body_m"],
          "properties": {
            "body_m": {"$ref": "#/$defs/box_m"},
            "cabin_m": {"$ref": "#/$defs/box_m"},
            "wheels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "radius_m", "width_m", "track_m", "wheelbase_m"],
              "properties": {
                "count": {"enum": [2, 4, 6]},
                "radius_m": {"$ref": "#/$defs/length_m"},
                "width_m": {"$ref": "#/$defs/length_m"},
                "track_m": {"$ref": "#/$defs/length_m"},
                "wheelbase_m": {"type": "number", "minimum": 0, "maximum": 50}
              }
            }
          }
        },
        "parts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["link", "label"],
            "properties": {
              "link": {
                "description": "The part this entry names: the vendor's own URDF link or GLB node name. With no vendor model (format none), or when the App falls back to the stand-in, the stand-in's shapes carry fixed generic anchor names a declaration may reference instead: body; cabin (only when fallback.cabin_m is declared); and one per wheel, wheel_left / wheel_right for a two-wheel (one-axle) declaration, wheel_front_left / wheel_front_right / wheel_rear_left / wheel_rear_right for four, and wheel_front_* / wheel_middle_* / wheel_rear_* (left / right) for six. Front is +x and left is +y (x forward, z up). A name the drawn model does not have gets no call-out; the part is still listed.",
                "$ref": "#/$defs/vendor_name"
              },
              "label": {"$ref": "#/$defs/localized"},
              "state_channel": {"type": "string", "minLength": 1, "maxLength": 128},
              "state_field": {"$ref": "#/$defs/field"},
              "unit": {"type": "string", "maxLength": 16},
              "precision": {"type": "integer", "minimum": 0, "maximum": 6}
            }
          }
        },
        "joints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["joint", "source"],
            "properties": {
              "joint": {"$ref": "#/$defs/vendor_name"},
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["channel"],
                "properties": {
                  "channel": {"type": "string", "minLength": 1, "maxLength": 128},
                  "field": {"$ref": "#/$defs/field"}
                }
              }
            }
          }
        },
        "credit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "license"],
          "properties": {
            "label": {"$ref": "#/$defs/localized"},
            "license": {"type": "string", "pattern": "^[A-Za-z0-9.+-]{1,64}$"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"format": {"enum": ["urdf", "glb"]}}},
          "then": {"required": ["source", "files"], "properties": {"files": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"format": {"const": "none"}}},
          "then": {"required": ["fallback"], "not": {"anyOf": [{"required": ["source"]}, {"required": ["files"]}]}}
        }
      ]
    }
  }
}
