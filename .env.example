# Production capability-request execution needs no robotics environment variables.
#
# The variables below exist only for reproducing the superseded HTTP
# gateway/Gazebo path. They are intentionally empty: there is no implicit
# loopback address and no credential belongs in source control.
FLYTO_ROBOTICS_GATEWAY_URL=
FLYTO_ROBOTICS_DELIVERY_TOKEN=
FLYTO_ROBOTICS_ROBOT_ID=
